# Copy to .env and fill in. Never commit .env.
# Google Gemini API key (get one free at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional overrides (defaults shown)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash-lite
JUDGE_MODEL=gemini-2.5-flash
MAX_TOKENS=4096
# Requests/min throttle (Gemini free tier allows ~15 RPM for flash-lite)
LLM_CALLS_PER_MIN=15
# Set by docker-compose; leave empty for in-memory Qdrant in local dev/tests
QDRANT_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_MODELING_ATTEMPTS=3
