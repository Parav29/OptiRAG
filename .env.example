# Copy to .env and fill in. Never commit .env.
# NVIDIA NIM API key (get one free at https://build.nvidia.com — no card).
NVIDIA_API_KEY=

# Optional overrides (defaults shown)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
JUDGE_MODEL=meta/llama-3.1-70b-instruct
MAX_TOKENS=4096
# Requests/min throttle (NVIDIA NIM free tier allows 40/min per account)
LLM_CALLS_PER_MIN=30
# Set by docker-compose; leave empty for in-memory Qdrant in local dev/tests
QDRANT_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_MODELING_ATTEMPTS=3
